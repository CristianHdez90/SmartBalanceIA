{
  "expo": {
    "name": "SmartBalanceIA",
    "slug": "smartbalanceia",
    "scheme": "mibalance",
    "version": "1.2.0",
    "orientation": "default",
    "platforms": [
      "android",
      "ios"
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cristianhdez.mibalance",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SmartBalanceIA usa tu ubicación cuando buscas promociones cercanas.",
        "NSMicrophoneUsageDescription": "SmartBalanceIA usa el micrófono cuando eliges dictar un gasto.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cristianhdez.mibalance",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#07091a",
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usa Face ID para proteger el acceso a tu información financiera."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07091a",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6366f1",
          "defaultChannel": "mi-balance-alerts-v2",
          "sounds": [
            "./assets/balance_chime.wav"
          ]
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "24eba997-66b7-4fca-9275-6716ae121f31"
      }
    },
    "owner": "cristiandevhdezs-team"
  }
}
