# Copia a .env.local y completa la clave privada solo allí.
GROQ_API_KEY=pega_aqui_tu_clave_privada
GROQ_MODEL=llama-3.3-70b-versatile
# Solo para crear el primer administrador en una instalación remota.
ADMIN_BOOTSTRAP_TOKEN=genera_un_valor_largo_y_aleatorio
# Correo transaccional para activación y recuperación.
RESEND_API_KEY=re_pega_aqui_tu_clave_privada
AUTH_EMAIL_FROM=Mi Balance <cuentas@tu-dominio-verificado.com>
APP_PUBLIC_URL=http://127.0.0.1:8787
# Firebase Authentication. Usa la clave web y una cuenta de servicio con permisos de Firebase Auth.
FIREBASE_WEB_API_KEY=AIzaSyDqnPQB7KMDVIlwELG9BnG4hHem6sZ2pzg
FIREBASE_PROJECT_ID=smartbalanceia-c70cf
FIREBASE_SERVICE_ACCOUNT_EMAIL=firebase-adminsdk-xxxxx@tu-id-de-proyecto.iam.gserviceaccount.com
# Guarda la clave en una sola línea con los saltos como \n. Nunca uses el prefijo NEXT_PUBLIC_.
FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"


